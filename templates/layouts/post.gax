---
layout: base
---
<article class="card p-5">
<h1><a href="{{ post.url }}">
{{ title }}</a></h1>
<h2 class="text-base mb-2">{{description}}</h2>
<p>
{% for tag in tags %}<a class="btn btn-primary btn-sm ms-1 mt-1 mb-1 me-1" href="/tags/{{ tag }}/"># {{ tag }}</a> {% endfor %}
</p>
{% if image %}
<img class="img-cover" alt="{{title}}" width="100%" height="100%" 
src="{{image}}"/>
{% endif %}
<div class="p-3">
<p><small>{{ date }}</small> </p>
{% if has_toc %}
<div class="toc card p-3">
{{ toc }}
</div>
{% endif %}
{{ content }}
<hr class="mt-3">
<div class="row mt-3">
<div class="col-lg-6 col-12">
{% if prev_post %}<a class="btn btn-primary btn-sm" href="{{ prev_post.url }}">← {{ prev_post.title }}</a>{% endif %}
</div>
<div class="col-6 text-end">
{% if next_post %}<a class="btn btn-primary btn-sm"
href="{{ next_post.url }}">{{ next_post.title }} →</a>{% endif %}
</div>
</div>
</div>
</article>