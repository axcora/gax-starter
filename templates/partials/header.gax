<nav class="navbar rounded-lg mb-3">
  <a class="navbar-brand" href="{{config.url}}">{{config.navbar.title}}</a>
  <button class="navbar-toggler" onclick="document.querySelector('.navbar-collapse').classList.toggle('show')">☰</button>
  <div class="navbar-collapse">
    <ul class="navbar-nav">
      {% for n in config.navbar.list %}
      <li class="nav-item"><a class="nav-link" href="{{n.url}}">{{n.name}}</a></li>
      {% endfor %}
    </ul>
  </div>
</nav>
